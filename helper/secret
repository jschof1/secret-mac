#!/usr/bin/python3
"""Local credentials, without evaluating shell code."""

import argparse
import contextlib
import ctypes
import dataclasses
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import stat
import sys
import tempfile


MAX_FILE_BYTES = 2 * 1024 * 1024
MAX_VALUE_BYTES = 64 * 1024
KEY = re.compile(r"[A-Z_][A-Z0-9_]*\Z", re.ASCII)
READ_ENTRY = re.compile(r"([A-Z0-9_]+)=(.*)\Z", re.ASCII)
WRITE_ENTRY = re.compile(r"[ \t]*(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)\Z", re.ASCII)
ANY_ASSIGNMENT = re.compile(r"[ \t]*(?:export[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]*=", re.ASCII)
BARE_VALUE = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./:@%+,=~^-")


class SecretError(Exception):
    pass


@dataclasses.dataclass(repr=False)
class Snapshot:
    requested: Path
    target: Path
    data: bytes
    identity: str

    @property
    def revision(self):
        digest = hashlib.sha256()
        digest.update(os.fsencode(self.target))
        digest.update(self.identity.encode("ascii"))
        digest.update(self.data)
        return digest.hexdigest()

    def lines(self):
        try:
            return self.data.decode("utf-8").split("\n")
        except UnicodeDecodeError:
            raise SecretError("The env file is not UTF-8. Edit it in a text editor.")


def store_path():
    return Path(os.environ.get("SECRETS_FILE") or str(Path.home() / ".env")).expanduser().absolute()


def snapshot(path):
    target = Path(os.path.realpath(str(path)))
    try:
        descriptor = os.open(str(target), os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return Snapshot(path, target, b"", "missing")
    except OSError:
        raise SecretError("Cannot open the env file. Check its location and permissions.")
    try:
        details = os.fstat(descriptor)
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid() or details.st_nlink != 1:
            raise SecretError("The env file must be a regular file owned by you, without hard links.")
        if details.st_size > MAX_FILE_BYTES:
            raise SecretError("The env file is too large.")
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            data = stream.read(MAX_FILE_BYTES + 1)
        after = os.fstat(descriptor)
        identity = lambda item: "%s:%s:%s:%s" % (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns)
        if len(data) > MAX_FILE_BYTES or identity(details) != identity(after):
            raise SecretError("The env file changed. Reload and try again.")
        return Snapshot(path, target, data, identity(after))
    finally:
        os.close(descriptor)


def names(document):
    result = []
    for line in document.lines():
        match = READ_ENTRY.fullmatch(line)
        if match:
            result.append(match.group(1))
    return result


def decode_value(raw):
    if raw.startswith(("'", '"')):
        try:
            words = shlex.split(raw, comments=False, posix=True)
        except ValueError:
            return raw
        if len(words) == 1:
            return words[0]
    return raw


def read_value(document, name, allow_empty=False):
    if re.fullmatch(r"[A-Z0-9_]+", name, re.ASCII) is None:
        raise SecretError("Use an env name containing uppercase letters, numbers and underscores.")
    for line in document.lines():
        match = READ_ENTRY.fullmatch(line)
        if match and match.group(1) == name:
            value = decode_value(match.group(2))
            if value or allow_empty:
                return value
            break
    raise SecretError("Env not found or empty.")


def simple_assignment_value(raw):
    quote = None
    escaped = False
    for index, character in enumerate(raw):
        if escaped:
            escaped = False
            continue
        if quote == "'":
            if character == "'":
                quote = None
            continue
        if quote == '"':
            if character == '"':
                quote = None
            elif character == "\\":
                escaped = True
            elif character in "$`":
                return False
            continue
        if character in ("'", '"'):
            quote = character
        elif character in " \t":
            remaining = raw[index:].lstrip(" \t")
            return not remaining or remaining.startswith("#")
        elif character not in BARE_VALUE:
            return False
    return quote is None and not escaped


def validate_document(document):
    if b"\0" in document.data or document.data.startswith(b"\xef\xbb\xbf"):
        raise SecretError("The env file has an unsupported format. Edit it in a text editor.")
    if b"\r" in document.data:
        raise SecretError("The env file uses Windows line endings. Convert it to LF in a text editor before saving.")
    lines = document.lines()
    for line in lines:
        content = line[:-1] if line.endswith("\r") else line
        if not content.strip() or content.lstrip().startswith("#"):
            continue
        match = WRITE_ENTRY.fullmatch(content)
        if not match or not simple_assignment_value(match.group(2)):
            raise SecretError("The env file has shell syntax or a multiline value. Edit it in a text editor.")
    return lines


def replacement(document, name, value, adding):
    if KEY.fullmatch(name) is None or len(name) > 255:
        raise SecretError("Use uppercase letters, numbers and underscores. Start with a letter or underscore.")
    if not value or any(character in value for character in "\0\r\n"):
        raise SecretError("Enter a value on one line.")
    if len(value.encode("utf-8")) > MAX_VALUE_BYTES:
        raise SecretError("The value is too long.")
    lines = validate_document(document)
    matches = []
    for index, line in enumerate(lines):
        match = ANY_ASSIGNMENT.match(line)
        if match and match.group(1) == name:
            matches.append(index)
    if len(matches) > 1:
        raise SecretError("This name appears more than once. Resolve the duplicates in a text editor.")
    if adding and matches:
        raise SecretError("This env already exists. Use Edit to change it.")
    if not adding and (not matches or READ_ENTRY.fullmatch(lines[matches[0]]) is None):
        raise SecretError("This env is no longer available. Reload and try again.")
    if not adding and decode_value(READ_ENTRY.fullmatch(lines[matches[0]]).group(2)) == value:
        return document.data
    newline = "\n"
    entry = name + "=" + shlex.quote(value)
    if adding:
        original = document.data.decode("utf-8")
        return (original + (newline if original and not original.endswith("\n") else "") + entry + newline).encode("utf-8")
    position = matches[0]
    lines[position] = entry
    return "\n".join(lines).encode("utf-8")


def private_directory(path):
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    details = path.lstat()
    if not stat.S_ISDIR(details.st_mode) or details.st_uid != os.geteuid():
        raise SecretError("The backup folder must be a folder owned by you.")
    os.chmod(str(path), 0o700)


def write_all(descriptor, data):
    with os.fdopen(descriptor, "wb", closefd=False) as stream:
        stream.write(data)
        stream.flush()
        os.fsync(descriptor)


def make_backup(document):
    directory = Path(os.environ.get("SECRET_BACKUP_DIR") or str(Path.home() / "Library/Application Support/Secret/Backups"))
    private_directory(directory)
    timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    descriptor, _ = tempfile.mkstemp(prefix="env-" + timestamp + "-", suffix=".bak", dir=str(directory))
    try:
        os.fchmod(descriptor, 0o600)
        write_all(descriptor, document.data)
    finally:
        os.close(descriptor)


def copy_extended_attributes(source, destination):
    if sys.platform == "darwin":
        library = ctypes.CDLL(None, use_errno=True)
        copyfile = library.copyfile
        copyfile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_uint32]
        copyfile.restype = ctypes.c_int
        flags = (1 << 2) | (1 << 18) | (1 << 19)
        if copyfile(os.fsencode(source), os.fsencode(destination), None, flags) != 0:
            raise OSError(ctypes.get_errno(), "Cannot preserve env metadata")
    elif hasattr(os, "listxattr"):
        for attribute in os.listxattr(str(source), follow_symlinks=False):
            os.setxattr(str(destination), attribute, os.getxattr(str(source), attribute, follow_symlinks=False), follow_symlinks=False)


@contextlib.contextmanager
def write_lock(target):
    filename = str(target) + ".secret.lock"
    descriptor = os.open(filename, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        details = os.fstat(descriptor)
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.geteuid() or details.st_nlink != 1:
            raise SecretError("Cannot safely lock the env file.")
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SecretError("The env file is being saved. Try again.")
        yield
    finally:
        os.close(descriptor)


def save(path, name, value, adding, expected):
    initial = snapshot(path)
    parent = initial.target.parent.stat()
    if parent.st_uid != os.geteuid():
        raise SecretError("The env folder must be owned by you.")
    with write_lock(initial.target):
        document = snapshot(path)
        if document.target != initial.target or document.revision != expected:
            raise SecretError("The env file changed. Cancel, reload and try again.")
        updated = replacement(document, name, value, adding)
        if updated == document.data:
            return False
        descriptor, temporary = tempfile.mkstemp(prefix=".secret-", dir=str(document.target.parent))
        try:
            os.fchmod(descriptor, 0o600)
            write_all(descriptor, updated)
            if document.identity != "missing":
                copy_extended_attributes(document.target, temporary)
                os.fsync(descriptor)
            make_backup(document)
            current = snapshot(path)
            if current.target != document.target or current.revision != document.revision:
                raise SecretError("The env file changed. Cancel, reload and try again.")
            os.replace(temporary, str(document.target))
            directory = os.open(str(document.target.parent), os.O_RDONLY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
            return True
        finally:
            os.close(descriptor)
            if os.path.exists(temporary):
                os.unlink(temporary)


def main(arguments=None):
    parser = argparse.ArgumentParser(prog="secret", description="Find and save local envs.")
    parser.add_argument("name", nargs="?")
    parser.add_argument("--list", "-l", action="store_true", help="list env names")
    parser.add_argument("--json", "-j", action="store_true", help="list names as JSON, without values")
    parser.add_argument("--export", "-e", action="store_true", dest="export", help="source the env file and print the exported environment (legacy)")
    parser.add_argument("--revision", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--inspect", metavar="NAME", help=argparse.SUPPRESS)
    parser.add_argument("--add", metavar="NAME", help="add an env, with its value on stdin")
    parser.add_argument("--set", metavar="NAME", help="update an env, with its value on stdin")
    parser.add_argument("--expected", metavar="REVISION", help=argparse.SUPPRESS)
    args = parser.parse_args(arguments)
    commands = [args.list, args.json, args.export, args.revision, args.inspect is not None, args.add is not None, args.set is not None, args.name is not None]
    if sum(bool(command) for command in commands) != 1 or (args.expected is not None and not (args.add or args.set)):
        parser.error("choose one command")
    path = store_path()
    if args.export:
        os.execv("/bin/bash", ["bash", "-c", 'set -euo pipefail; set -a; . "$1"; set +a; env | grep -E "^[A-Z0-9_]+=" | sort', "secret", str(path)])
    document = snapshot(path)
    if args.list:
        output = names(document)
        if output:
            print("\n".join(output))
    elif args.json:
        print(json.dumps(names(document)))
    elif args.revision:
        print(document.revision)
    elif args.inspect is not None:
        print(json.dumps({"name": args.inspect, "value": read_value(document, args.inspect, allow_empty=True), "revision": document.revision}))
    elif args.add is not None or args.set is not None:
        if not args.expected or re.fullmatch(r"[0-9a-f]{64}", args.expected) is None:
            raise SecretError("Read --revision before saving and pass it with --expected.")
        data = sys.stdin.buffer.read(MAX_VALUE_BYTES + 1)
        if len(data) > MAX_VALUE_BYTES:
            raise SecretError("The value is too long.")
        try:
            value = data.decode("utf-8")
        except UnicodeDecodeError:
            raise SecretError("The value must be UTF-8 text.")
        changed = save(path, args.add if args.add is not None else args.set, value, args.add is not None, args.expected)
        print("Saved" if changed else "Unchanged")
    else:
        sys.stdout.write(read_value(document, args.name))


if __name__ == "__main__":
    try:
        main()
    except SecretError as error:
        print("secret: " + str(error), file=sys.stderr)
        sys.exit(2)
    except (OSError, UnicodeError):
        print("secret: Could not access or save the env file. Check its permissions and backup folder.", file=sys.stderr)
        sys.exit(3)
